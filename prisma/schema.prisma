// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  businessName    String?
  phone           String?
  // Forgot-password flow. Single-use, short-lived opaque token (not the
  // calendar feed's long-lived subscription token — this one is cleared
  // after one successful reset or once expired). Null means no reset in
  // progress.
  resetToken           String?   @unique
  resetTokenExpiresAt  DateTime?
  // Optional persona name for automated first-touch communication (missed-call
  // auto-text, instant-ack drafts) — e.g. "Nora." Null means no persona: those
  // messages stay generic/unsigned, exactly today's behavior. Deliberately not
  // used on agent-initiated content (manual follow-up drafts, check-ins) —
  // those still read as coming from the agent, not an assistant persona.
  assistantName   String?
  autoAckEnabled  Boolean  @default(false)
  // Push automation (Phase 5). dailyDigestEnabled emails the agent their own
  // "needs attention" brief on a schedule — low risk (they're emailing
  // themselves), so it defaults on. autoNurtureEnabled sends warm check-ins to
  // sphere contacts unsupervised — real outbound to real people, so it mirrors
  // autoAckEnabled and defaults OFF until the agent opts in.
  dailyDigestEnabled Boolean @default(true)
  autoNurtureEnabled Boolean @default(false)
  // Auto-posts a newly generated listing straight to Instagram — real
  // unsupervised publishing to a public platform, higher stakes than any
  // other auto-send in this app, so off by default like autoNurtureEnabled.
  autoPostInstagramEnabled Boolean @default(false)
  // Same idea as autoPostInstagramEnabled, but posting to the agent's Facebook
  // Page instead — a separate credential/toggle since Facebook Page posting
  // uses a Page Access Token, not the Instagram user token above.
  autoPostFacebookEnabled Boolean @default(false)
  // TikTok auto-post connection. Unlike Instagram/Facebook (static tokens
  // pasted into env vars), TikTok requires real per-agent OAuth: the access
  // token expires every 24h and the refresh token rotates on every use, so
  // both must live here and be kept current rather than fetched once. Null
  // fields mean "not connected yet" (see src/lib/tiktok.server.ts).
  autoPostTiktokEnabled Boolean   @default(false)
  tiktokOpenId          String?
  tiktokAccessToken     String?
  tiktokRefreshToken    String?
  tiktokTokenExpiresAt  DateTime?
  // Best-effort display label for which real TikTok account is connected
  // ("@handle", falling back to a nickname) — the developer app itself
  // (see TikTok's developer portal) doesn't say this, since one app can be
  // authorized by many different creator accounts. Captured once at connect
  // time (see /api/tiktok/callback); null just means it wasn't available,
  // never blocks the connection itself (see getConnectedAccountLabel).
  tiktokAccountLabel String?
  // Google OAuth connection — powers Google Contacts birthday sync (Sphere)
  // and on-demand Gmail thread history (Leads/Sphere). Read-only scopes, no
  // unsupervised sending, so there's no enabled/disabled toggle the way
  // auto-post/auto-nurture have one — "connected" already means "on." Same
  // null-means-not-connected convention as the TikTok fields above (see
  // src/lib/google.server.ts). googleRefreshToken isn't always re-issued on
  // a re-consent, so it's preserved rather than overwritten when absent.
  googleEmail             String?
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiresAt    DateTime?
  googleContactsSyncedAt  DateTime?
  // Opaque secret in the agent's private iCal feed URL. Calendar apps fetch a
  // subscription URL with no auth header, so the unguessable token IS the
  // credential; regenerating it revokes any previously shared link. Null until
  // the agent first generates a feed.
  calendarToken   String?  @unique
  createdAt       DateTime @default(now())

  listings     Listing[]
  leads        Lead[]
  callLogs     CallLog[]
  transactions Transaction[]
  contacts     Contact[]
  buyers       Buyer[]
}

model Listing {
  id                  String   @id @default(cuid())
  agentId             String
  agent               Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  address              String
  beds                Int
  baths               Float
  sqft                Int
  price               Int
  features            String
  generatedDescription String?
  socialPosts         String? // JSON array of { platform, caption, hashtags } — see src/lib/prompts/listing.ts
  createdAt           DateTime @default(now())

  // Outcome of an auto-post attempt to Instagram (see src/lib/instagram.server.ts).
  // instagramPostId is the published media's ID when it succeeds; instagramPostError
  // holds the reason when it doesn't (missing photo, no IG post, API error, etc.).
  // Both null means auto-post was off or never attempted for this listing.
  instagramPostId    String?
  instagramPostedAt  DateTime?
  instagramPostError String?

  // Same outcome-tracking pattern for a Facebook Page auto-post (see
  // src/lib/facebook.server.ts).
  facebookPostId    String?
  facebookPostedAt  DateTime?
  facebookPostError String?

  // Same outcome-tracking pattern for a TikTok photo-post auto-post (see
  // src/lib/tiktok.server.ts). tiktokPostId is TikTok's publish_id — an async
  // job id, not a final post id (TikTok processes the post after this).
  tiktokPostId    String?
  tiktokPostedAt  DateTime?
  tiktokPostError String?

  // The source site's listing detail page URL, set only for listings created
  // by the automated listing-sync cron job (see src/lib/listing-sync.server.ts).
  // Manually-created listings leave this null. This is how the sync job knows
  // a listing was already onboarded and skips it on future runs, instead of
  // re-creating and re-posting it every day.
  sourceUrl String? @unique

  photos ListingPhoto[]

  @@index([agentId])
}

// A listing's real photos, uploaded to Vercel Blob storage (this app is
// serverless, so there's no local disk to keep files on). Deliberately just a
// URL + order — the actual generation/upload happens client-side, this model
// just records what landed.
model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Lead {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  source          String?
  notes           String?
  status          String    @default("new")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())

  emailLogs    EmailLog[]
  textLogs     TextLog[]
  interactions Interaction[]
  transactions Transaction[]
  buyers       Buyer[]

  @@index([agentId])
  @@index([agentId, status])
}

model EmailLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String   @default("followup") // "followup" (manual, agent-triggered) | "instant_ack" (automatic, on inbound lead creation)
  subject   String
  body      String
  status    String   @default("draft")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model TextLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String   @default("instant_ack") // only kind that exists today; field exists so a future manual-text feature doesn't collide
  body      String
  status    String   @default("draft")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// A quick, freeform log of a touch that isn't an EmailLog/TextLog send — a phone
// call, an in-person chat, anything the agent wants on record. Deliberately just
// a note and a timestamp, not a structured CRM form (see Phase 2 task list, 2A).
model Interaction {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// A real deal, once a lead is under contract — deliberately its own model and its
// own status enum rather than overloading Lead.status further (see Phase 3 task
// list, 3A). leadId is optional since not every transaction traces back to a
// tracked lead (an off-market referral, or an existing client from before this
// tool existed).
model Transaction {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyAddress String
  side            String // "buyer" | "seller"
  contractDate    DateTime?
  closingDate     DateTime?
  status          String    @default("active") // "active" | "closed" | "fell_through"
  // Deal financials, both optional — the agent may not know the number at
  // conversion and can fill it in later. salePrice is the contract price;
  // commissionRate is this side's rate as a percent (e.g. 2.5 = 2.5%). Together
  // they drive real GCI in Reports; when the rate is blank an assumed default
  // is used just for the estimate.
  salePrice       Int?
  commissionRate  Float?
  createdAt       DateTime  @default(now())

  milestones      Milestone[]
  contacts        TransactionContact[]
  sphereContacts  Contact[]

  @@index([agentId])
  @@index([leadId])
}

// A third party involved in a transaction — a lender, a title company, or the
// other side's agent. Needed because chase emails go to people who aren't
// Leads and have nowhere else to live in the schema (see Phase 3 task list, 3C).
model TransactionContact {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  role          String // "lender" | "title" | "other_agent" | "other"
  name          String
  email         String
  createdAt     DateTime    @default(now())

  chaseLogs ChaseLog[]

  @@index([transactionId])
}

// Mirrors EmailLog's draft-then-send shape, but tied to a TransactionContact
// instead of a Lead — same discipline, never an autonomous send.
model ChaseLog {
  id                   String             @id @default(cuid())
  transactionContactId String
  transactionContact   TransactionContact @relation(fields: [transactionContactId], references: [id], onDelete: Cascade)
  subject              String
  body                 String
  status               String             @default("draft")
  sentAt               DateTime?
  createdAt            DateTime           @default(now())

  @@index([transactionContactId])
}

// A deadline on a transaction — deliberately freeform (a label + a date), not
// fixed columns, since deal structure varies (cash vs. financed, buyer vs.
// seller side, and conventions differ by state/brokerage). A default set gets
// created when a transaction converts (see Phase 3 task list, 3B); the agent
// can complete, delete, or add their own from there.
model Milestone {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  label         String
  dueDate       DateTime
  completed     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// A sphere-of-influence relationship — a past client, friend, family member, or
// referral source the agent wants to stay in touch with long-term. Deliberately
// separate from Lead (an active prospect) rather than another Lead.status value —
// this isn't a funnel stage, it's a different kind of relationship entirely (see
// Phase 4 task list, 4A). transactionId is optional: some contacts trace back to
// a closed deal, others (family, personal referral sources) never do.
model Contact {
  id              String       @id @default(cuid())
  agentId         String
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String?
  relationship    String       @default("past_client") // "past_client" | "friend" | "family" | "referral_source" | "other"
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime     @default(now())
  // Synced from Google Contacts (People API), matched to this Contact by
  // email — see src/lib/birthday-sync.server.ts. Three separate optional
  // ints, not a DateTime: Google's own birthday field is independently
  // optional per-component and commonly omits the year, so forcing a fake
  // placeholder year would poison any "days until birthday" math.
  // googleContactResourceName is People API's stable id for the matched
  // contact, so a re-sync updates in place instead of re-matching by email
  // every run.
  birthdayMonth              Int?
  birthdayDay                Int?
  birthdayYear               Int?
  googleContactResourceName  String?

  checkInLogs   CheckInLog[]
  contactTouches ContactTouch[]

  @@index([agentId])
  @@index([transactionId])
}

// Mirrors Interaction exactly, but for a Contact instead of a Lead — a
// parallel model rather than a nullable-either-or shape on Interaction,
// matching the precedent already set by TextLog/EmailLog and ChaseLog/EmailLog
// (see Phase 4 task list, 4D).
model ContactTouch {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

// Mirrors EmailLog/ChaseLog's draft-then-send shape, tied to a Contact instead
// of a Lead/TransactionContact — a warm "just checking in" note, not a lead
// follow-up or a document chase (see Phase 4 task list, 4C).
model CheckInLog {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    String   @default("draft")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([contactId])
}

model CallLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  callerNumber String
  missed       Boolean  @default(false)
  textSent     Boolean  @default(false)
  textBody     String?
  createdAt    DateTime @default(now())

  @@index([agentId])
}

// A buyer the agent is actively representing on the buy side (Phase 5 buyer
// workflow). Deliberately its own model, not a Lead.status stage or a
// Transaction: a Lead is an unqualified prospect and a Transaction is a deal
// already under contract, whereas a buyer is a client mid-search — criteria to
// match against, homes to tour, showings to schedule. leadId is optional since
// not every buyer traces back to a tracked lead (a referral, a repeat client).
// All search-criteria fields are optional: a buyer often only knows a few.
model Buyer {
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name              String
  email             String?
  phone             String?
  status            String   @default("active") // "active" | "under_contract" | "closed" | "inactive"
  locations         String? // freeform, comma-separated towns/neighbourhoods
  minPrice          Int?
  maxPrice          Int?
  minBeds           Int?
  minBaths          Float?
  propertyType      String? // "single_family" | "condo" | "townhouse" | "multi_family" | "any"
  mustHaves         String?
  preApproved       Boolean  @default(false)
  preApprovalAmount Int?
  notes             String?
  createdAt         DateTime @default(now())

  properties BuyerProperty[]
  showings   Showing[]

  @@index([agentId])
  @@index([leadId])
}

// A specific home under consideration for a buyer — a candidate the agent
// pulled from the MLS or the buyer flagged. Deliberately just enough to track
// and match (price + beds/baths + type) plus a status as it moves toward an
// offer. Not a mirror of the MLS.
model BuyerProperty {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  address      String
  price        Int?
  beds         Int?
  baths        Float?
  propertyType String?
  listingUrl   String?
  status       String   @default("considering") // "considering" | "showing_scheduled" | "toured" | "rejected" | "offer_made"
  notes        String?
  createdAt    DateTime @default(now())

  showings Showing[]

  @@index([buyerId])
}

// A scheduled property tour for a buyer. Ties to a BuyerProperty when the home
// is already tracked, but keeps its own address so a one-off showing doesn't
// require creating a property record first. Upcoming, not-yet-completed showings
// surface in the "needs attention" set (Overview + Today), mirroring how urgent
// milestones do for transactions.
model Showing {
  id              String         @id @default(cuid())
  buyerId         String
  buyer           Buyer          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerPropertyId String?
  buyerProperty   BuyerProperty? @relation(fields: [buyerPropertyId], references: [id], onDelete: SetNull)
  address         String
  scheduledAt     DateTime
  completed       Boolean        @default(false)
  feedback        String?
  createdAt       DateTime       @default(now())

  @@index([buyerId])
  @@index([buyerPropertyId])
}
